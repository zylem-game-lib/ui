{
  "name": "@zylem/ui",
  "version": "0.8.11",
  "description": "Design tokens, global styles, and Solid components for Zylem, built with vanilla-extract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zylem-game-lib/ui.git"
  },
  "homepage": "https://github.com/zylem-game-lib/ui#readme",
  "bugs": {
    "url": "https://github.com/zylem-game-lib/ui/issues"
  },
  "keywords": [
    "zylem",
    "design-tokens",
    "vanilla-extract",
    "solid-js",
    "ui"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts"
    },
    "./build-label": {
      "types": "./src/components/BuildLabel/mount-build-label.ts",
      "import": "./src/components/BuildLabel/mount-build-label.ts"
    },
    "./vite": {
      "types": "./vite/index.ts",
      "import": "./vite/index.ts"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src",
    "vite"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "NODE_ENV=production tsup",
    "dev": "tsup --watch",
    "showcase": "vite --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check ."
  },
  "peerDependencies": {
    "solid-js": "^1.9.9"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@clack/prompts": "^1.6.0",
    "@solidjs/testing-library": "^0.8.10",
    "@vanilla-extract/esbuild-plugin": "^2.3.22",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "happy-dom": "^20.11.2",
    "solid-js": "^1.9.9",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "vite": "7.0.4",
    "vite-plugin-solid": "^2.11.8",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@vanilla-extract/css": "^1.20.1",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "lucide-solid": "^0.511.0"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.32.1"
  },
  "packageManager": "pnpm@10.33.0"
}
